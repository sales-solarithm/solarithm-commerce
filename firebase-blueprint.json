{
  "rulesVersion": 2,
  "collections": [
    {
      "name": "approvals",
      "path": "approvals/{approvalId}",
      "description": "Password reset requests and access approvals",
      "fields": {
        "type": { "type": "string" },
        "requestedEmail": { "type": "string" },
        "email": { "type": "string", "optional": true },
        "appName": { "type": "string", "optional": true },
        "appId": { "type": "string", "optional": true },
        "employeeName": { "type": "string", "optional": true },
        "name": { "type": "string", "optional": true },
        "employeeId": { "type": "string", "optional": true },
        "reason": { "type": "string", "optional": true },
        "status": { "type": "string" },
        "timestamp": { "type": "timestamp" },
        "createdAt": { "type": "string", "optional": true },
        "tempPassword": { "type": "string", "optional": true },
        "resolvedAt": { "type": "string", "optional": true },
        "resolvedBy": { "type": "string", "optional": true }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.resource.data.type == 'PASSWORD_RESET_REQUEST'",
        "update": "request.auth != null",
        "delete": "false"
      }
    },
    {
      "name": "employees",
      "path": "employees/{employeeId}",
      "description": "Central company directory and KYC record store",
      "fields": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string", "optional": true },
        "department": { "type": "string", "optional": true },
        "designation": { "type": "string", "optional": true },
        "role": { "type": "string", "optional": true },
        "employeeId": { "type": "string", "optional": true }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "false",
        "update": "false",
        "delete": "false"
      }
    },
    {
      "name": "registeredApps",
      "path": "registeredApps/{appId}",
      "description": "Central registered ecosystem applications",
      "fields": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string", "optional": true },
        "icon": { "type": "string", "optional": true },
        "category": { "type": "string", "optional": true },
        "active": { "type": "boolean" },
        "allowedRoles": { "type": "array", "optional": true }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "false",
        "update": "false",
        "delete": "false"
      }
    },
    {
      "name": "auditLogs",
      "path": "auditLogs/{logId}",
      "description": "Ecosystem audit logs and telemetry",
      "fields": {
        "action": { "type": "string" },
        "actor": { "type": "string" },
        "target": { "type": "string", "optional": true },
        "details": { "type": "any", "optional": true },
        "timestamp": { "type": "timestamp" }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.auth != null",
        "update": "false",
        "delete": "false"
      }
    },
    {
      "name": "users",
      "path": "users/{uid}",
      "description": "User profiles and roles",
      "fields": {
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "false",
        "update": "false",
        "delete": "false"
      }
    },
    {
      "name": "clients",
      "path": "clients/{clientId}",
      "description": "Clients registered by sales personnel",
      "fields": {
        "companyName": { "type": "string" },
        "contactPerson": { "type": "string", "optional": true },
        "email": { "type": "string", "optional": true },
        "clientEmail": { "type": "string", "optional": true },
        "phone": { "type": "string", "optional": true },
        "contactNumber": { "type": "string", "optional": true },
        "state": { "type": "string", "optional": true },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "gstin": { "type": "string", "optional": true },
        "proposalNumber": { "type": "string" },
        "remarks": { "type": "string", "optional": true },
        "registeredBy": { "type": "string" },
        "registeredByUID": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "approvedAt": { "type": "timestamp", "optional": true },
        "approvedBy": { "type": "string", "optional": true },
        "pricingCategory": { "type": "string", "optional": true }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.auth != null && request.resource.data.registeredByUID == request.auth.uid",
        "update": "request.auth != null",
        "delete": "false"
      }
    },
    {
      "name": "projects",
      "path": "projects/{projectId}",
      "description": "Projects submitted by sales",
      "fields": {
        "projectName": { "type": "string" },
        "projectDate": { "type": "string" },
        "clientName": { "type": "string" },
        "clientId": { "type": "string" },
        "scopeOfWork": { "type": "string" },
        "plantCapacity": { "type": "number", "optional": true },
        "designerEmail": { "type": "string" },
        "designerName": { "type": "string" },
        "salesPersonEmail": { "type": "string" },
        "srNumber": { "type": "string" },
        "status": { "type": "string" },
        "projectCost": { "type": "number", "optional": true },
        "designerHolding": { "type": "number", "optional": true },
        "salesHolding": { "type": "number", "optional": true },
        "remainingBalance": { "type": "number", "optional": true },
        "invoiceNumber": { "type": "string", "optional": true },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.auth != null",
        "update": "request.auth != null",
        "delete": "false"
      }
    },
    {
      "name": "proposals",
      "path": "proposals/{proposalId}",
      "description": "Pre-registered proposals",
      "fields": {
        "status": { "type": "string" }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "false",
        "update": "false",
        "delete": "false"
      }
    },
    {
      "name": "scopes",
      "path": "scopes/{scopeId}",
      "description": "Active scopes of work",
      "fields": {
        "name": { "type": "string" },
        "subServices": { "type": "array", "optional": true }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "false",
        "update": "false",
        "delete": "false"
      }
    },
    {
      "name": "designers",
      "path": "designers/{designerId}",
      "description": "Active designers",
      "fields": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "rules": {
        "read": "request.auth != null",
        "create": "false",
        "update": "false",
        "delete": "false"
      }
    }
  ]
}
